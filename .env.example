# AI Gateway environment configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env
#
# In docker-compose, REDIS_ADDR / PORT are overridden with container DNS
# names, so the values below are for bare-metal runs.

# ---------------------------------------------------------------------------
# Redis (hot state: tokens, CB credits, disabled flags, gateway keys, rate)
# ---------------------------------------------------------------------------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# Log backend (request/response history for /history* endpoints)
# ---------------------------------------------------------------------------
#   LOG_BACKEND=sqlite   (default) → embedded modernc.org/sqlite, ~0 ops cost
#
# The ClickHouse backend was removed (deprecated Aug 2026 — heavy for the
# value it added). LOG_BACKEND=clickhouse now logs a warning and falls back
# to sqlite instead of failing.
#
# SQLite stores the DB file at LOG_SQLITE_PATH (default below). Persist this
# path across container restarts by mounting a docker volume onto it.
# ---------------------------------------------------------------------------
LOG_BACKEND=sqlite
LOG_SQLITE_PATH=/var/lib/foxrouters/logs.db

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
PORT=20130

# ---------------------------------------------------------------------------
# Development mode (dev.sh sets these automatically — DO NOT set in prod)
# ---------------------------------------------------------------------------
# WORKERS_DISABLED=1        → skip background workers (token refresh, credit sync)
# HEALTH_PROBES_DISABLED=1  → skip health-check probes to upstream
# TOKEN_REFRESH_DISABLED=1  → gate ALL token refresh paths (on-demand + 401-retry)
#
# When TOKEN_REFRESH_DISABLED=1, toDTO() zeroes AccessToken/RefreshToken/IDToken
# so credentials never persist to dev Redis (leak prevention). Use with:
#   ./dev.sh up    — starts isolated dev stack (own Redis, port 20131)
#   ./dev.sh seed  — copies credentials from prod Redis (read-only)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Bootstrap credentials (first-run seed only — persisted to Redis after)
# After first boot, Redis is the single source of truth and these are unused.
# Leave empty to manage credentials via REST API instead.
# ---------------------------------------------------------------------------
# GATEWAY_KEY_FILE=./gateway-key.txt
# GATEWAY_API_KEYS=            # comma-separated gateway keys
# CB_KEY_FILE=./codebuddy-key.txt

# CodeBuddy key selection strategy (rr|sticky|content-hash|hybrid).
#   rr            — round-robin (no cache locality)
#   sticky        — session-id binds conversation to one key (DEFAULT)
#   content-hash  — system prompt hash → deterministic key (shared cache)
#   hybrid        — content-hash bucket + sticky within bucket
# Runtime switchable via PUT /cb/selector-mode (Redis-persisted, overrides env).
CB_SELECTOR_MODE=sticky
# CB_API_KEYS=                 # comma-separated CodeBuddy keys

# ---------------------------------------------------------------------------
# Turnstile Solver — used by Grok image-gen lazy SSO re-login (401 → solve →
# console.x.ai sign-in). The solver (Cloudflare-Turnstile-Bypass, PM2/bun) runs
# on the HOST; containers reach it via host.docker.internal (host-gateway).
# Runtime switchable via dashboard Settings (Redis gw:config, overrides env).
# TURNSTILE_SOLVER_URL=http://host.docker.internal:8742/cloudflare
# TURNSTILE_SITEKEY=0x4AAAAAAAhr9JGVDZbrZOo0

# ---------------------------------------------------------------------------
# Freebuff (Codebuff rebrand) — free LLM via ad-supported tier
# ---------------------------------------------------------------------------
# Set to 1 to disable the Freebuff provider entirely.
FREEBUFF_DISABLED=
# Daily streak worker interval (ads + streak check-in per account).
# Default 24h; min 1h. Worker is gated by WORKERS_DISABLED in dev.
FREEBUFF_STREAK_INTERVAL=24h
# Relay base URL for full-access tier. Routes session/chat/ads/streak/run API
# calls through a PaaS relay (Railway/CF Worker) whose exit IP is not
# VPN/datacenter-flagged. Device flow (OAuth login) always hits codebuff.com
# directly. Leave empty for direct (limited/blocked from datacenter IPs).
# NOTE: runtime-overridable — GET/PUT /fb/config (dashboard Freebuff tab)
# persists to Redis (fb:config) and wins over this env default after boot.
# Example: https://freebuff-relay-production-xxxx.up.railway.app
FREEBUFF_BASE_URL=
# Cap for a single stored request/response body in SQLite history (bytes).
# Default 1 MiB — keeps full bodies for normal traffic, prevents multi-MB rows
# (huge-context requests) from bloating the DB and blocking history readers.
LOG_BODY_CAP_BYTES=1048576
# Freebuff accounts are managed via REST API (POST /fb/import, /fb/import/bulk)
# or dashboard. No file-based bootstrap needed.
# Models: fb/deepseek-v4-flash, fb/mimo-v2.5 (limited), fb/deepseek-v4-pro,
#         fb/minimax-m3, fb/gpt-5.6-luna, fb/glm-5.2 (full mode only)

# ---------------------------------------------------------------------------
# Alibaba Cloud Model Studio (DashScope) — free tier LLM + image/video media
# ---------------------------------------------------------------------------
# Set to 1 to disable the Alibaba provider entirely.
ALIBABA_DISABLED=
# Keys are managed via REST API (POST /ali/import, /ali/import/bulk) or
# dashboard — no file-based bootstrap.
# Chat models: ali/qwen3.7-flash, ali/qwen3.7-max, ... (dynamic registry).
# Media Studio: ali/qwen-image-3.0 (gen), ali/qwen-image-edit (edit),
#               ali/wan2.6-t2v (video) — no SSO/DPoP/Turnstile needed.

# ---------------------------------------------------------------------------
# Dev override — set to `1` to disable Bearer auth on all endpoints.
# LEAVE EMPTY IN PRODUCTION.
# ---------------------------------------------------------------------------
GATEWAY_AUTH_DISABLE=

# ---------------------------------------------------------------------------
# Grok image generation (console.x.ai DPoP, free tier, v1.6.7+ dev)
# POST /v1/images/generations — pure Go, no sidecar. Accounts need `sso` +
# `sso_rw` cookies in Redis (import via POST /accounts/import with sso field;
# obtain via grok-dpop/grok_console_login.py browser login).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (first-class Go feature, v1.6.0)
#
# The gateway now runs cloudflared as an embedded subprocess (data plane)
# and drives named-tunnel lifecycle via the cloudflare-go v7 SDK (control
# plane). One container, no separate tunnel container.
#
# Runtime configuration lives in Redis (`fr:tunnel:config`) so mode +
# credentials survive restarts and are managed from the dashboard's
# "Tunnel" page (or the /api/tunnel/* endpoints).
#
# The env vars below are optional seeds only:
#   - CLOUDFLARED_PATH:  where the manager finds the cloudflared binary
#                        (auto-set to /usr/local/bin/cloudflared inside
#                        the Docker image).
#   - TUNNEL_UPSTREAM_URL: what cloudflared proxies to. Defaults to
#                         http://127.0.0.1:<PORT>. Override only if the
#                         gateway binds to a non-loopback interface.
#
# Legacy TUNNEL_MODE (read by install.sh + old tunnel.sh) is still
# honoured for install-time defaults, but runtime state is Redis-driven.
# ---------------------------------------------------------------------------
CLOUDFLARED_PATH=/usr/local/bin/cloudflared
# TUNNEL_UPSTREAM_URL=http://127.0.0.1:20130

# Named-tunnel credentials — optional seed only, normally set via the
# dashboard's Tunnel page. When present at boot AND the persisted mode
# is `named` or `hybrid` with no stored credentials, they seed Redis.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=
# TUNNEL_DOMAIN=

# Install-time default used by install.sh (none|quick|named).
TUNNEL_MODE=none
